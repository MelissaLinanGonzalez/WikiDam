// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum ResourceType {
  VIDEO_YOUTUBE
  VIDEO_FILE
  PDF
  IMAGE
  LINK
}

enum DoubtStatus {
  OPEN
  CLOSED
}

enum Occupation {
  STUDENT
  WORKER
  PROFESSOR
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  password     String?    // Opcional para usuarios de Google
  role         Role       @default(STUDENT)
  occupation   Occupation @default(STUDENT)
  contactEmail String?
  image        String?
  createdAt    DateTime   @default(now())
  
  resources    Resource[]
  doubts       Doubt[]
  comments     Comment[]

  @@map("users")
}

model Subject {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?    @db.Text
  icon        String?
  color       String?
  createdAt   DateTime   @default(now())
  
  youtubers   Youtuber[]
  resources   Resource[]
  doubts      Doubt[]

  @@map("subjects")
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  icon      String?
  createdAt DateTime   @default(now())
  
  resources Resource[]
  doubts    Doubt[]

  @@map("categories")
}

model Youtuber {
  id         String     @id @default(cuid())
  name       String
  channelUrl String
  
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  String
  
  resources  Resource[]

  @@map("youtubers")
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  url         String?
  filePath    String?
  type        ResourceType
  
  // --- CORRECCIÓN CRÍTICA AQUÍ ABAJO (Los signos ?) ---
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String?      
  // ----------------------------------------------------

  youtuber    Youtuber?    @relation(fields: [youtuberId], references: [id], onDelete: SetNull)
  youtuberId  String?

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  
  categories  Category[]
  
  createdAt   DateTime     @default(now())

  @@map("resources")
}

model Doubt {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  attachments String[]
  status      DoubtStatus  @default(OPEN)
  createdAt   DateTime     @default(now())
  
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  
  subjects    Subject[]
  categories  Category[]
  comments    Comment[]

  @@map("doubts")
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  attachments String[]
  createdAt   DateTime @default(now())
  
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  
  doubt       Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  doubtId     String

  @@map("comments")
}